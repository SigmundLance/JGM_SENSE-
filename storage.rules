rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{userId}/profile.jpg {
      // getDownloadURL() embeds a download token in the URL, and the
      // Storage serving layer grants access based on that token for
      // alt=media requests - regardless of what this rule says, and
      // regardless of whether the request carries a Firebase Auth
      // header (RN's <Image> never sends one). So "if request.auth !=
      // null" would not actually block unauthenticated reads here; it
      // would just misrepresent what's enforced. The real access
      // control for this file is the token's unguessability, not this
      // rule - this rule only matters for non-token access paths
      // (e.g. someone trying to list or guess the path directly).
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }
  }
}
